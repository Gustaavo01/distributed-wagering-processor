
# ======================================
# APLICACAO
# ======================================

NODE_ENV=development
PORT=3000

# ======================================
# POSTGRESQL LOCAL
# ======================================

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=wagering_user
DB_PASSWORD=wagering_dev_password
DB_NAME=wagering_db

# ======================================
# AWS SQS / MINISTACK
# ======================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566

# ======================================
# WORKERS
# ======================================

PENDING_REFERENCE_WORKER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
WAGER_SQS_CONSUMER_ENABLED=true

# ======================================
# OBSERVABILIDADE
# ======================================

# Exemplo apenas.
# Configure um token forte no .env real.
METRICS_TOKEN=substitua-este-token-no-ambiente-real
