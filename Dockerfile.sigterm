
FROM oven/bun:1.4.4

WORKDIR /app

# Instala as dependencias usando o lockfile.
COPY . .

RUN bun install --frozen-lockfile

# Compila a aplicacao NestJS.
RUN bun run build

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# O Bun sera o processo principal do container.
# Assim o Docker enviara SIGTERM diretamente a ele.
CMD ["bun", "dist/main.js"]
